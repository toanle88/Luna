{
  "name": "luna-period-tracker",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build && node scripts/generate-pwa.mjs && node scripts/validate-pwa.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "release:check": "node scripts/check-release.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "description": "A browser-local period tracker with Vietnamese and English locales, cycle estimates, JSON backups, and PWA support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toanle88/Luna.git"
  },
  "homepage": "https://github.com/toanle88/Luna#readme",
  "bugs": {
    "url": "https://github.com/toanle88/Luna/issues"
  }
}
